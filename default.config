# webserv - configuration par defaut
# Tous les chemins sont relatifs au dossier depuis lequel on lance ./webserv
# (la racine du repo).

# ===== Site 1 : la vitrine de toutes les fonctionnalites =====
server {
    listen 127.0.0.1:8080;
    root ./www/site1;
    index index.html;
    client_max_body_size 1M;
    error_page 404 ./www/site1/errors/404.html;

    # Pages statiques du site
    location / {
        methods GET;
    }

    # Dossier navigable : listing automatique (pas d'index.html dedans)
    location /files {
        root ./www/site1/files;
        methods GET;
        autoindex on;
    }

    # Upload, lecture et suppression de fichiers
    location /upload {
        root ./www/site1/uploads;
        methods GET POST DELETE;
        upload_store ./www/site1/uploads;
        client_max_body_size 10M;
    }

    # Scripts executes par le CGI
    location /cgi-bin {
        root ./www/site1/cgi-bin;
        methods GET POST;
        cgi .py /usr/bin/python3;
    }

    # Ancienne URL redirigee vers l'accueil
    location /old {
        return 301 /;
    }
}

# ===== Site 2 : un autre contenu sur un autre port =====
server {
    listen 8081;
    root ./www/site2;
    index index.html;

    location / {
        methods GET;
    }
}
